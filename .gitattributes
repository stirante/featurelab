# core.autocrlf=true rewrites checked-out files to CRLF, but gofmt only ever
# emits LF -- so every `gofmt -l` run flagged the entire package as unformatted
# and every "fix" produced a diff that was pure line-ending noise. One pass
# spent real effort separating a single genuine change out of eighteen such
# files. Pinning the working-tree ending for the file types our tooling
# rewrites removes the conflict rather than re-fighting it.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Same reasoning for the JS/TS toolchain: prettier/esbuild/vitest all assume LF.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf

# Wiki pages are written by tools that emit LF, and the
# wiki image pipeline reads fixtures alongside them; mixed endings here show
# up as whole-file diffs for the same reason the Go sources did.
*.md text eol=lf

# The golden digest is generated by goldengen and diffed byte-for-byte; a
# line-ending rewrite would show the whole file as changed.
goldentest/testdata/*.json text eol=lf

# Shell scripts must keep LF or they fail to execute on the CI runners. The Python tools next
# to them are pinned for the same reason as everything above -- they are written and rewritten by
# tooling that emits LF, and a line-ending flip makes a one-line edit read as a whole-file one.
*.sh text eol=lf
*.py text eol=lf

# CI workflows and the ignore/attribute files themselves, for the same reason as everything
# above: they are edited by tooling that emits LF, they are read on Linux runners, and a
# line-ending rewrite makes a one-line change look like a whole-file one.
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.vscodeignore text eol=lf
.npmrc text eol=lf
.editorconfig text eol=lf
